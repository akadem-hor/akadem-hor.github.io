---
import content from '../content.json'

interface Props {
  size?: 'normal' | 'large'
  class?: string
}

const { size = 'normal', class: extra = '' } = Astro.props
const { ссылка_на_форму, текст_кнопки } = content.заявка

// Минимум 44px по высоте — иначе по кнопке трудно попасть пальцем.
const sizes = {
  normal: 'px-6 py-3 text-lg',
  large: 'px-8 py-3.5 text-lg',
}

// Кнопка может вести и наружу, и на блок этой же страницы. Внутреннюю ссылку
// нельзя открывать в новой вкладке: человек получит вторую копию страницы
// вместо перехода к расписанию.
const внешняя = !ссылка_на_форму.startsWith('#')
---

<a
  href={ссылка_на_форму}
  target={внешняя ? '_blank' : undefined}
  rel={внешняя ? 'noopener' : undefined}
  data-goal="prihod"
  class:list={[
    // Контурная, как «Посмотреть на карте» (решено 08.10.2026). Залитая
    // кнопка крупным шрифтом выглядела грубо рядом со спокойной страницей.
    // Подсветка при наведении полупрозрачная, а не цветом accent-soft:
    // в блоке контактов фон и так accent-soft, и подсветка там пропадала.
    'inline-block rounded-md border-2 border-accent font-bold text-accent',
    'hover:bg-accent/10',
    sizes[size],
    extra,
  ]}
>
  {текст_кнопки}
</a>
