---
/**
 * Название хора с лавровой ветвью над последней буквой.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы сразу: называет хор, ставит ударение и отсылает
 * к лавру, то есть к академии.
 *
 * Поэтому в разметке, в заголовке страницы и в карточке на Картах имя
 * остаётся обычным «Голоса»: там ветвь нарисовать негде, а люди ищут
 * без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь вешается на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Три числа ниже задают положение ветви. Если она встанет не туда,
      править нужно только их:
        left  — сдвиг вправо от начала последней буквы
        top   — подъём над строкой, отрицательное число поднимает
        width — размер ветви относительно высоты шрифта
    -->
    <svg
      viewBox="-6 -22 68 56"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="left: .16em; top: -.30em; width: .86em; height: auto;"
    ><g fill="currentColor"><path d="M2 26Q22 4 52 2" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><path d="M0 0C3.42 -7 12.16 -5.88 19 -2.28C12.16 2.2 3.8 4.37 0 0Z" transform="translate(6.1 21.8) rotate(-105.6)"/><path d="M0 0C3.13 -6.4 11.13 -5.38 17.39 -2.09C11.13 2.01 3.48 4 0 0Z" transform="translate(15.36 14.28) rotate(-96.37)"/><path d="M0 0C2.84 -5.81 10.09 -4.88 15.77 -1.89C10.09 1.83 3.15 3.63 0 0Z" transform="translate(25.5 8.53) rotate(-86.72)"/><path d="M0 0C2.55 -5.21 9.06 -4.38 14.15 -1.7C9.06 1.64 2.83 3.25 0 0Z" transform="translate(36.53 4.54) rotate(-77.17)"/><path d="M0 0C2.26 -4.62 8.03 -3.88 12.54 -1.5C8.03 1.45 2.51 2.88 0 0Z" transform="translate(48.44 2.31) rotate(-68.21)"/></g></svg>
  </span>
</span>
