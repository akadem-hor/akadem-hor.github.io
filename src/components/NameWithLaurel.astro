---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-46 -54 96 60"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 1.1em; left: -0.257em; top: 0.100em; height: auto;"
    ><g fill="currentColor"><path d="M-32.77 -22.94A40 40 0 0 1 34.64 -20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M0 0C1.73 -3.46 6.14 -2.86 9.6 -1.15C6.14 1.06 1.92 2.16 0 0Z" transform="translate(-32.77 -22.94) rotate(-101)"/><path d="M0 0C1.73 -3.46 6.14 -2.86 9.6 -1.15C6.14 1.06 1.92 2.16 0 0Z" transform="translate(-32.77 -22.94) rotate(-9)"/><path d="M0 0C1.64 -3.28 5.84 -2.72 9.12 -1.09C5.84 1.01 1.82 2.05 0 0Z" transform="translate(-26.04 -30.36) rotate(-86.63)"/><path d="M0 0C1.64 -3.28 5.84 -2.72 9.12 -1.09C5.84 1.01 1.82 2.05 0 0Z" transform="translate(-26.04 -30.36) rotate(5.38)"/><path d="M0 0C1.56 -3.11 5.53 -2.58 8.64 -1.04C5.53 0.96 1.73 1.94 0 0Z" transform="translate(-17.69 -35.87) rotate(-72.25)"/><path d="M0 0C1.56 -3.11 5.53 -2.58 8.64 -1.04C5.53 0.96 1.73 1.94 0 0Z" transform="translate(-17.69 -35.87) rotate(19.75)"/><path d="M0 0C1.47 -2.94 5.22 -2.43 8.16 -0.98C5.22 0.9 1.63 1.84 0 0Z" transform="translate(-8.23 -39.14) rotate(-57.88)"/><path d="M0 0C1.47 -2.94 5.22 -2.43 8.16 -0.98C5.22 0.9 1.63 1.84 0 0Z" transform="translate(-8.23 -39.14) rotate(34.13)"/><path d="M0 0C1.38 -2.76 4.92 -2.29 7.68 -0.92C4.92 0.85 1.54 1.73 0 0Z" transform="translate(1.74 -39.96) rotate(-43.5)"/><path d="M0 0C1.38 -2.76 4.92 -2.29 7.68 -0.92C4.92 0.85 1.54 1.73 0 0Z" transform="translate(1.74 -39.96) rotate(48.5)"/><path d="M0 0C1.3 -2.59 4.61 -2.15 7.2 -0.86C4.61 0.8 1.44 1.62 0 0Z" transform="translate(11.61 -38.28) rotate(-29.13)"/><path d="M0 0C1.3 -2.59 4.61 -2.15 7.2 -0.86C4.61 0.8 1.44 1.62 0 0Z" transform="translate(11.61 -38.28) rotate(62.88)"/><path d="M0 0C1.21 -2.42 4.3 -2 6.72 -0.81C4.3 0.74 1.34 1.51 0 0Z" transform="translate(20.75 -34.2) rotate(-14.75)"/><path d="M0 0C1.21 -2.42 4.3 -2 6.72 -0.81C4.3 0.74 1.34 1.51 0 0Z" transform="translate(20.75 -34.2) rotate(77.25)"/><path d="M0 0C1.12 -2.25 3.99 -1.86 6.24 -0.75C3.99 0.69 1.25 1.4 0 0Z" transform="translate(28.59 -27.97) rotate(-0.38)"/><path d="M0 0C1.12 -2.25 3.99 -1.86 6.24 -0.75C3.99 0.69 1.25 1.4 0 0Z" transform="translate(28.59 -27.97) rotate(91.63)"/><path d="M0 0C1.04 -2.07 3.69 -1.72 5.76 -0.69C3.69 0.64 1.15 1.3 0 0Z" transform="translate(34.64 -20) rotate(14)"/><path d="M0 0C1.04 -2.07 3.69 -1.72 5.76 -0.69C3.69 0.64 1.15 1.3 0 0Z" transform="translate(34.64 -20) rotate(106)"/></g></svg>
  </span>
</span>
