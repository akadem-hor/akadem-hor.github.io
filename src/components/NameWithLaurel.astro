---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-26 -46 66 62"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 1.2em; left: -0.20em; top: -0.30em; height: auto;"
    ><g fill="currentColor"><path d="M-6.24 -29.34A30 30 0 0 1 29.11 7.26" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><path d="M0 0C2.43 -5.38 8.64 -4.51 13.5 -1.62C8.64 1.82 2.7 3.35 0 0Z" transform="translate(-6.24 -29.34) rotate(194)"/><path d="M0 0C2.29 -5.07 8.15 -4.26 12.74 -1.53C8.15 1.72 2.55 3.17 0 0Z" transform="translate(1.31 -29.97) rotate(208.5)"/><path d="M0 0C2.16 -4.77 7.67 -4.01 11.98 -1.44C7.67 1.62 2.4 2.98 0 0Z" transform="translate(8.77 -28.69) rotate(223)"/><path d="M0 0C2.02 -4.47 7.18 -3.75 11.22 -1.35C7.18 1.51 2.24 2.79 0 0Z" transform="translate(15.67 -25.58) rotate(237.5)"/><path d="M0 0C1.88 -4.17 6.7 -3.5 10.46 -1.26C6.7 1.41 2.09 2.6 0 0Z" transform="translate(21.58 -20.84) rotate(252)"/><path d="M0 0C1.75 -3.86 6.21 -3.25 9.7 -1.16C6.21 1.31 1.94 2.41 0 0Z" transform="translate(26.11 -14.77) rotate(266.5)"/><path d="M0 0C1.61 -3.56 5.72 -2.99 8.94 -1.07C5.72 1.21 1.79 2.22 0 0Z" transform="translate(28.98 -7.76) rotate(281)"/><path d="M0 0C1.47 -3.26 5.24 -2.74 8.18 -0.98C5.24 1.1 1.64 2.03 0 0Z" transform="translate(30 -0.26) rotate(295.5)"/><path d="M0 0C1.34 -2.96 4.75 -2.48 7.43 -0.89C4.75 1 1.49 1.84 0 0Z" transform="translate(29.11 7.26) rotate(310)"/></g></svg>
  </span>
</span>
