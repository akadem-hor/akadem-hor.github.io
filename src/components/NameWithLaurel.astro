---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-36 -42 76 72"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 0.95em; left: -0.180em; top: 0.016em; height: auto;"
    ><g fill="currentColor"><path d="M-19.92 -16.71A26 26 0 0 1 22.52 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M0 0C2.07 -3.84 7.36 -3.18 11.5 -1.38C7.36 1.08 2.3 2.4 0 0Z" transform="translate(-19.92 -16.71) rotate(-94)"/><path d="M0 0C2.07 -3.84 7.36 -3.18 11.5 -1.38C7.36 1.08 2.3 2.4 0 0Z" transform="translate(-19.92 -16.71) rotate(-6)"/><path d="M0 0C1.88 -3.49 6.7 -2.89 10.46 -1.26C6.7 0.98 2.09 2.18 0 0Z" transform="translate(-7.17 -24.99) rotate(-60)"/><path d="M0 0C1.88 -3.49 6.7 -2.89 10.46 -1.26C6.7 0.98 2.09 2.18 0 0Z" transform="translate(-7.17 -24.99) rotate(28)"/><path d="M0 0C1.7 -3.15 6.04 -2.61 9.43 -1.13C6.04 0.89 1.89 1.97 0 0Z" transform="translate(8.03 -24.73) rotate(-26)"/><path d="M0 0C1.7 -3.15 6.04 -2.61 9.43 -1.13C6.04 0.89 1.89 1.97 0 0Z" transform="translate(8.03 -24.73) rotate(62)"/><path d="M0 0C1.51 -2.8 5.37 -2.32 8.39 -1.01C5.37 0.79 1.68 1.75 0 0Z" transform="translate(20.49 -16.01) rotate(8)"/><path d="M0 0C1.51 -2.8 5.37 -2.32 8.39 -1.01C5.37 0.79 1.68 1.75 0 0Z" transform="translate(20.49 -16.01) rotate(96)"/><path d="M0 0C1.32 -2.46 4.71 -2.04 7.36 -0.88C4.71 0.69 1.47 1.54 0 0Z" transform="translate(25.94 -1.81) rotate(42)"/><path d="M0 0C1.32 -2.46 4.71 -2.04 7.36 -0.88C4.71 0.69 1.47 1.54 0 0Z" transform="translate(25.94 -1.81) rotate(130)"/><path d="M0 0C1.14 -2.11 4.05 -1.75 6.33 -0.76C4.05 0.59 1.27 1.32 0 0Z" transform="translate(22.52 13) rotate(76)"/><path d="M0 0C1.14 -2.11 4.05 -1.75 6.33 -0.76C4.05 0.59 1.27 1.32 0 0Z" transform="translate(22.52 13) rotate(164)"/></g></svg>
  </span>
</span>
