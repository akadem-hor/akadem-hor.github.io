---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-30 -44 76 66"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 1em; left: -0.125em; top: -0.039em; height: auto;"
    ><g fill="currentColor"><path d="M-11.4 -23.37A26 26 0 0 1 25.86 2.72" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M0 0C2.7 -6.27 9.6 -5.19 15 -1.8C9.6 2.22 3 3.92 0 0Z" transform="translate(-11.4 -23.37) rotate(204)"/><path d="M0 0C2.51 -5.82 8.91 -4.82 13.93 -1.67C8.91 2.06 2.79 3.64 0 0Z" transform="translate(-3.88 -25.71) rotate(221.43)"/><path d="M0 0C2.31 -5.38 8.23 -4.45 12.86 -1.54C8.23 1.9 2.57 3.36 0 0Z" transform="translate(4 -25.69) rotate(238.86)"/><path d="M0 0C2.12 -4.93 7.54 -4.08 11.79 -1.41C7.54 1.74 2.36 3.08 0 0Z" transform="translate(11.51 -23.31) rotate(256.29)"/><path d="M0 0C1.93 -4.48 6.86 -3.71 10.71 -1.29C6.86 1.58 2.14 2.8 0 0Z" transform="translate(17.97 -18.79) rotate(273.71)"/><path d="M0 0C1.74 -4.03 6.17 -3.34 9.64 -1.16C6.17 1.43 1.93 2.52 0 0Z" transform="translate(22.77 -12.55) rotate(291.14)"/><path d="M0 0C1.54 -3.58 5.49 -2.97 8.57 -1.03C5.49 1.27 1.71 2.24 0 0Z" transform="translate(25.48 -5.15) rotate(308.57)"/><path d="M0 0C1.35 -3.14 4.8 -2.6 7.5 -0.9C4.8 1.11 1.5 1.96 0 0Z" transform="translate(25.86 2.72) rotate(326)"/></g></svg>
  </span>
</span>
