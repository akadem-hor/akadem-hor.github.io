---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-22 -42 66 84"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 0.9em; left: -0.030em; top: -0.032em; height: auto;"
    ><g fill="currentColor"><path d="M3.62 -25.75A26 26 0 0 1 19.32 17.4" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"/><path d="M0 0C2.52 -5.89 8.96 -4.88 14 -1.68C8.96 2.09 2.8 3.68 0 0Z" transform="translate(3.62 -25.75) rotate(-38)"/><path d="M0 0C2.52 -5.89 8.96 -4.88 14 -1.68C8.96 2.09 2.8 3.68 0 0Z" transform="translate(3.62 -25.75) rotate(54)"/><path d="M0 0C2.31 -5.4 8.21 -4.47 12.83 -1.54C8.21 1.92 2.57 3.37 0 0Z" transform="translate(12.47 -22.81) rotate(-17.33)"/><path d="M0 0C2.31 -5.4 8.21 -4.47 12.83 -1.54C8.21 1.92 2.57 3.37 0 0Z" transform="translate(12.47 -22.81) rotate(74.67)"/><path d="M0 0C2.1 -4.91 7.47 -4.06 11.67 -1.4C7.47 1.74 2.33 3.07 0 0Z" transform="translate(19.72 -16.94) rotate(3.33)"/><path d="M0 0C2.1 -4.91 7.47 -4.06 11.67 -1.4C7.47 1.74 2.33 3.07 0 0Z" transform="translate(19.72 -16.94) rotate(95.33)"/><path d="M0 0C1.89 -4.42 6.72 -3.66 10.5 -1.26C6.72 1.57 2.1 2.76 0 0Z" transform="translate(24.43 -8.89) rotate(24)"/><path d="M0 0C1.89 -4.42 6.72 -3.66 10.5 -1.26C6.72 1.57 2.1 2.76 0 0Z" transform="translate(24.43 -8.89) rotate(116)"/><path d="M0 0C1.68 -3.93 5.97 -3.25 9.33 -1.12C5.97 1.39 1.87 2.45 0 0Z" transform="translate(26 0.3) rotate(44.67)"/><path d="M0 0C1.68 -3.93 5.97 -3.25 9.33 -1.12C5.97 1.39 1.87 2.45 0 0Z" transform="translate(26 0.3) rotate(136.67)"/><path d="M0 0C1.47 -3.43 5.23 -2.84 8.17 -0.98C5.23 1.22 1.63 2.15 0 0Z" transform="translate(24.22 9.46) rotate(65.33)"/><path d="M0 0C1.47 -3.43 5.23 -2.84 8.17 -0.98C5.23 1.22 1.63 2.15 0 0Z" transform="translate(24.22 9.46) rotate(157.33)"/><path d="M0 0C1.26 -2.94 4.48 -2.44 7 -0.84C4.48 1.05 1.4 1.84 0 0Z" transform="translate(19.32 17.4) rotate(86)"/><path d="M0 0C1.26 -2.94 4.48 -2.44 7 -0.84C4.48 1.05 1.4 1.84 0 0Z" transform="translate(19.32 17.4) rotate(178)"/></g></svg>
  </span>
</span>
