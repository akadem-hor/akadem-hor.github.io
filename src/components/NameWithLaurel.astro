---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-36 -45 80 70"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 0.9em; left: -0.135em; top: 0.033em; height: auto;"
    ><g fill="currentColor"><path d="M-21.21 -21.21A30 30 0 0 1 27.82 11.24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M0 0C1.89 -3.58 6.72 -2.97 10.5 -1.26C6.72 1.04 2.1 2.24 0 0Z" transform="translate(-21.21 -21.21) rotate(-89)"/><path d="M0 0C1.89 -3.58 6.72 -2.97 10.5 -1.26C6.72 1.04 2.1 2.24 0 0Z" transform="translate(-21.21 -21.21) rotate(-1)"/><path d="M0 0C1.77 -3.35 6.29 -2.78 9.82 -1.18C6.29 0.97 1.96 2.1 0 0Z" transform="translate(-11.52 -27.7) rotate(-66.57)"/><path d="M0 0C1.77 -3.35 6.29 -2.78 9.82 -1.18C6.29 0.97 1.96 2.1 0 0Z" transform="translate(-11.52 -27.7) rotate(21.43)"/><path d="M0 0C1.65 -3.12 5.86 -2.59 9.15 -1.1C5.86 0.9 1.83 1.95 0 0Z" transform="translate(-0.07 -30) rotate(-44.14)"/><path d="M0 0C1.65 -3.12 5.86 -2.59 9.15 -1.1C5.86 0.9 1.83 1.95 0 0Z" transform="translate(-0.07 -30) rotate(43.86)"/><path d="M0 0C1.53 -2.89 5.42 -2.4 8.47 -1.02C5.42 0.84 1.7 1.81 0 0Z" transform="translate(11.38 -27.76) rotate(-21.71)"/><path d="M0 0C1.53 -2.89 5.42 -2.4 8.47 -1.02C5.42 0.84 1.7 1.81 0 0Z" transform="translate(11.38 -27.76) rotate(66.29)"/><path d="M0 0C1.4 -2.66 4.99 -2.2 7.8 -0.94C4.99 0.77 1.56 1.66 0 0Z" transform="translate(21.11 -21.32) rotate(0.71)"/><path d="M0 0C1.4 -2.66 4.99 -2.2 7.8 -0.94C4.99 0.77 1.56 1.66 0 0Z" transform="translate(21.11 -21.32) rotate(88.71)"/><path d="M0 0C1.28 -2.43 4.56 -2.01 7.13 -0.85C4.56 0.7 1.43 1.52 0 0Z" transform="translate(27.64 -11.65) rotate(23.14)"/><path d="M0 0C1.28 -2.43 4.56 -2.01 7.13 -0.85C4.56 0.7 1.43 1.52 0 0Z" transform="translate(27.64 -11.65) rotate(111.14)"/><path d="M0 0C1.16 -2.2 4.13 -1.82 6.45 -0.77C4.13 0.64 1.29 1.38 0 0Z" transform="translate(30 -0.22) rotate(45.57)"/><path d="M0 0C1.16 -2.2 4.13 -1.82 6.45 -0.77C4.13 0.64 1.29 1.38 0 0Z" transform="translate(30 -0.22) rotate(133.57)"/><path d="M0 0C1.04 -1.97 3.7 -1.63 5.78 -0.69C3.7 0.57 1.16 1.23 0 0Z" transform="translate(27.82 11.24) rotate(68)"/><path d="M0 0C1.04 -1.97 3.7 -1.63 5.78 -0.69C3.7 0.57 1.16 1.23 0 0Z" transform="translate(27.82 11.24) rotate(156)"/></g></svg>
  </span>
</span>
