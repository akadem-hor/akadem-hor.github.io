---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-30 -46 74 68"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 0.82em; left: -0.022em; top: 0.031em; height: auto;"
    ><g fill="currentColor"><path d="M-15.02 -28.25A32 32 0 0 1 30.76 8.82" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M0 0C1.8 -3.58 6.4 -2.97 10 -1.2C6.4 1.1 2 2.24 0 0Z" transform="translate(-15.02 -28.25) rotate(-72)"/><path d="M0 0C1.8 -3.58 6.4 -2.97 10 -1.2C6.4 1.1 2 2.24 0 0Z" transform="translate(-15.02 -28.25) rotate(16)"/><path d="M0 0C1.68 -3.35 5.99 -2.78 9.36 -1.12C5.99 1.03 1.87 2.1 0 0Z" transform="translate(-4.93 -31.62) rotate(-52.86)"/><path d="M0 0C1.68 -3.35 5.99 -2.78 9.36 -1.12C5.99 1.03 1.87 2.1 0 0Z" transform="translate(-4.93 -31.62) rotate(35.14)"/><path d="M0 0C1.57 -3.12 5.58 -2.59 8.71 -1.05C5.58 0.96 1.74 1.95 0 0Z" transform="translate(5.71 -31.49) rotate(-33.71)"/><path d="M0 0C1.57 -3.12 5.58 -2.59 8.71 -1.05C5.58 0.96 1.74 1.95 0 0Z" transform="translate(5.71 -31.49) rotate(54.29)"/><path d="M0 0C1.45 -2.89 5.17 -2.4 8.07 -0.97C5.17 0.88 1.61 1.81 0 0Z" transform="translate(15.72 -27.87) rotate(-14.57)"/><path d="M0 0C1.45 -2.89 5.17 -2.4 8.07 -0.97C5.17 0.88 1.61 1.81 0 0Z" transform="translate(15.72 -27.87) rotate(73.43)"/><path d="M0 0C1.34 -2.66 4.75 -2.2 7.43 -0.89C4.75 0.81 1.49 1.66 0 0Z" transform="translate(23.99 -21.17) rotate(4.57)"/><path d="M0 0C1.34 -2.66 4.75 -2.2 7.43 -0.89C4.75 0.81 1.49 1.66 0 0Z" transform="translate(23.99 -21.17) rotate(92.57)"/><path d="M0 0C1.22 -2.43 4.34 -2.01 6.79 -0.81C4.34 0.74 1.36 1.52 0 0Z" transform="translate(29.61 -12.14) rotate(23.71)"/><path d="M0 0C1.22 -2.43 4.34 -2.01 6.79 -0.81C4.34 0.74 1.36 1.52 0 0Z" transform="translate(29.61 -12.14) rotate(111.71)"/><path d="M0 0C1.11 -2.2 3.93 -1.82 6.14 -0.74C3.93 0.67 1.23 1.38 0 0Z" transform="translate(31.95 -1.75) rotate(42.86)"/><path d="M0 0C1.11 -2.2 3.93 -1.82 6.14 -0.74C3.93 0.67 1.23 1.38 0 0Z" transform="translate(31.95 -1.75) rotate(130.86)"/><path d="M0 0C0.99 -1.97 3.52 -1.63 5.5 -0.66C3.52 0.6 1.1 1.23 0 0Z" transform="translate(30.76 8.82) rotate(62)"/><path d="M0 0C0.99 -1.97 3.52 -1.63 5.5 -0.66C3.52 0.6 1.1 1.23 0 0Z" transform="translate(30.76 8.82) rotate(150)"/></g></svg>
  </span>
</span>
