---
/**
 * Название хора с лавровой ветвью на последней букве.
 *
 * Ветвь стоит там, где нужен знак ударения: «Голоса» без него читается
 * как «гóлоса» — родительный падеж единственного числа. Одно изображение
 * делает три работы: называет хор, ставит ударение и отсылает к лавру,
 * то есть к академии.
 *
 * В разметке, в заголовке страницы и в карточке на Картах имя остаётся
 * обычным «Голоса»: там ветвь нарисовать негде, а люди ищут без значков.
 */
interface Props {
  название: string
  class?: string
}

const { название, class: extra = '' } = Astro.props

// Ветвь садится на последнюю букву, поэтому имя делится на две части.
const начало = название.slice(0, -1)
const последняя = название.slice(-1)
---

<span class:list={['inline-block', extra]}>
  {начало}<span class="relative inline-block">
    {последняя}
    <!--
      Ветвь — дуга, обнимающая букву справа сверху. Три числа задают её
      положение, править нужно только их:
        width — размер ветви относительно высоты шрифта
        left  — сдвиг вправо, отрицательное число двигает влево
        top   — подъём, отрицательное число поднимает
      Значения посчитаны так, чтобы центр дуги совпал с центром буквы.
    -->
    <svg
      viewBox="-26 -40 66 60"
      aria-hidden="true"
      class="absolute pointer-events-none"
      style="width: 0.731em; left: 0.022em; top: 0.097em; height: auto;"
    ><g fill="currentColor"><path d="M-12.21 -22.96A26 26 0 0 1 24.99 7.17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M0 0C1.76 -3.46 6.27 -2.86 9.8 -1.18C6.27 1.04 1.96 2.16 0 0Z" transform="translate(-12.21 -22.96) rotate(-72)"/><path d="M0 0C1.76 -3.46 6.27 -2.86 9.8 -1.18C6.27 1.04 1.96 2.16 0 0Z" transform="translate(-12.21 -22.96) rotate(16)"/><path d="M0 0C1.63 -3.2 5.8 -2.65 9.07 -1.09C5.8 0.96 1.81 2 0 0Z" transform="translate(-2.57 -25.87) rotate(-49.67)"/><path d="M0 0C1.63 -3.2 5.8 -2.65 9.07 -1.09C5.8 0.96 1.81 2 0 0Z" transform="translate(-2.57 -25.87) rotate(38.33)"/><path d="M0 0C1.5 -2.94 5.33 -2.43 8.33 -1C5.33 0.88 1.67 1.84 0 0Z" transform="translate(7.46 -24.91) rotate(-27.33)"/><path d="M0 0C1.5 -2.94 5.33 -2.43 8.33 -1C5.33 0.88 1.67 1.84 0 0Z" transform="translate(7.46 -24.91) rotate(60.67)"/><path d="M0 0C1.37 -2.68 4.86 -2.22 7.6 -0.91C4.86 0.8 1.52 1.67 0 0Z" transform="translate(16.36 -20.21) rotate(-5)"/><path d="M0 0C1.37 -2.68 4.86 -2.22 7.6 -0.91C4.86 0.8 1.52 1.67 0 0Z" transform="translate(16.36 -20.21) rotate(83)"/><path d="M0 0C1.23 -2.42 4.39 -2 6.86 -0.82C4.39 0.73 1.37 1.51 0 0Z" transform="translate(22.81 -12.47) rotate(17.33)"/><path d="M0 0C1.23 -2.42 4.39 -2 6.86 -0.82C4.39 0.73 1.37 1.51 0 0Z" transform="translate(22.81 -12.47) rotate(105.33)"/><path d="M0 0C1.1 -2.16 3.92 -1.79 6.13 -0.73C3.92 0.65 1.23 1.35 0 0Z" transform="translate(25.84 -2.87) rotate(39.67)"/><path d="M0 0C1.1 -2.16 3.92 -1.79 6.13 -0.73C3.92 0.65 1.23 1.35 0 0Z" transform="translate(25.84 -2.87) rotate(127.67)"/><path d="M0 0C0.97 -1.9 3.45 -1.57 5.39 -0.65C3.45 0.57 1.08 1.19 0 0Z" transform="translate(24.99 7.17) rotate(62)"/><path d="M0 0C0.97 -1.9 3.45 -1.57 5.39 -0.65C3.45 0.57 1.08 1.19 0 0Z" transform="translate(24.99 7.17) rotate(150)"/></g></svg>
  </span>
</span>
