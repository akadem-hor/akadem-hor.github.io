---
import content from '../content.json'
import Section from './Section.astro'
import ApplyButton from './ApplyButton.astro'

const {
  сайт,
  заявка,
  обложка,
  о_хоре,
  хормейстеры,
  кого_ждём,
  репетиции,
  видео,
  галерея,
  анонсы,
  достижения,
  вопросы,
  контакты,
} = content

// Фон блоков чередуется, чтобы соседние не сливались в одно полотно.
//
// Раньше цвет был проставлен у каждого блока вручную — и ломался, как только
// блок исчезал. Так и случилось: после удаления анонсов и достижений
// «Фотографии» и «Частые вопросы» оказались рядом с одинаковым фоном.
//
// Теперь цвет вычисляется по факту: перебираем блоки в том порядке, в каком
// они стоят на странице, пропускаем пустые и раздаём фон так, чтобы он всегда
// отличался от предыдущего. Добавление и удаление блоков больше ничего
// не портит.
const порядок_блоков = [
  { id: 'about' },
  { id: 'conductor', есть: хормейстеры.люди.length > 0 },
  { id: 'who', фон: 'accent' },
  { id: 'rehearsals' },
  { id: 'video', есть: видео.записи.length > 0 },
  { id: 'gallery', есть: галерея.снимки.length > 0 },
  { id: 'events', есть: анонсы.события.length > 0 },
  { id: 'achievements', есть: достижения.пункты.length > 0 },
  { id: 'contacts', фон: 'accent' },
  { id: 'faq' },
]

const тон: Record<string, 'paper' | 'surface' | 'accent'> = {}
let предыдущий = ''
for (const блок of порядок_блоков) {
  if (блок.есть === false) continue
  const цвет = блок.фон ?? (предыдущий === 'paper' ? 'surface' : 'paper')
  тон[блок.id] = цвет as 'paper' | 'surface' | 'accent'
  предыдущий = цвет
}

// Счётчик Яндекс Метрики. Собирается строкой, чтобы номер счётчика попадал
// в код на этапе сборки, а не подставлялся в браузере.
//
// Вторая половина — отслеживание цели. Метрика сама считает, сколько людей
// пришло, но не знает, что для нас важно. Клик по кнопке «Прийти на
// репетицию» — единственное действие на странице, которое означает решение
// человека. Обработчик один на всю страницу и ловит любой элемент с
// атрибутом data-goal, поэтому кнопок может быть сколько угодно.
const метрика = `
(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,
k.src=r,a.parentNode.insertBefore(k,a)})
(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
ym(${сайт.счётчик_метрики},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
document.addEventListener('click',function(e){
  var t=e.target;
  if(!t||!t.closest)return;
  var el=t.closest('[data-goal]');
  if(el)ym(${сайт.счётчик_метрики},'reachGoal',el.getAttribute('data-goal'));
});
`
---

    <!-- Обложка -->
    <header class="bg-surface border-b border-line">
      <!--
        Порядок как на концертной афише: сначала имя, под ним черта, затем
        кто это такие, и только потом приглашение. Раньше строчка «любительский
        академический хор» стояла и над названием, и в первой фразе под ним —
        одно и то же дважды в трёх строках, из-за чего короткое имя выглядело
        зажатым между двумя подписями.
      -->
      <div class="mx-auto w-full max-w-3xl px-5 py-12 md:py-16">
        {/*
          Название и описательная строка — внутри одного h1.

          Выглядит это ровно так же, как если бы они были разными элементами,
          но для поисковика разница большая: h1 — самый весомый заголовок
          страницы, и он должен говорить, что это за сайт. Заголовок из одного
          слова «Голоса» не сообщает ни того, что это хор, ни города.

          Черта между ними — украшение, поэтому скрыта от программ чтения
          с экрана: вслух заголовок читается как «Голоса. Любительский
          академический хор в Екатеринбурге».
        */}
        <h1 class="text-ink mb-5">
          <span class="block font-display text-6xl md:text-8xl leading-none">
            {обложка.название}
          </span>
          <span class="block w-24 h-0.5 bg-accent mt-6 mb-5" aria-hidden="true"></span>
          <span class="block font-display text-2xl md:text-3xl text-accent leading-snug">
            {обложка.подзаголовок}
          </span>
        </h1>

        <p class="text-xl md:text-2xl text-muted leading-relaxed mb-8">
          {обложка.главная_фраза}
        </p>

        <ApplyButton size="large" />
      </div>
      <img
        src={обложка.фото}
        alt={обложка.описание_фото}
        width="1600"
        height="900"
        class="w-full h-auto object-cover"
      />
    </header>

    <!-- О хоре -->
    <Section id="about" title={о_хоре.заголовок} tone={тон.about}>
      {
        о_хоре.абзацы.map((абзац) => (
          <p class="text-lg md:text-xl text-muted mb-5 last:mb-0">{абзац}</p>
        ))
      }
    </Section>

    <!-- Хормейстеры -->
    {
      хормейстеры.люди.length > 0 && (
        <Section id="conductor" title={хормейстеры.заголовок} tone={тон.conductor}>
          <div class="grid gap-8 sm:grid-cols-2">
            {хормейстеры.люди.map((человек) => (
              <div>
                {человек.фото && (
                  /*
                    Единая форма кадра для всех портретов: снимки приходят
                    разных пропорций — вертикальные, квадратные, — и без этого
                    колонки получаются разной высоты, блок выглядит рваным.
                  */
                  <img
                    src={человек.фото}
                    alt={человек.имя}
                    width="400"
                    height="500"
                    class="w-full aspect-[4/5] rounded-md object-cover object-top mb-5"
                  />
                )}
                <p class="font-display text-2xl text-ink mb-1">{человек.имя}</p>
                <p class="text-accent font-semibold mb-4">{человек.должность}</p>
                {человек.о_нём.map((абзац) => (
                  <p class="text-lg text-muted mb-4 last:mb-0">{абзац}</p>
                ))}
              </div>
            ))}
          </div>
        </Section>
      )
    }

    <!-- Кого ждём -->
    <Section id="who" title={кого_ждём.заголовок} tone={тон.who}>
      <p class="text-xl text-muted mb-8">{кого_ждём.вступление}</p>

      <ul class="grid sm:grid-cols-2 gap-5 mb-10">
        {
          кого_ждём.пункты.map((пункт) => (
            <li class="bg-surface rounded-md p-6 border border-line">
              <p class="font-sans font-semibold text-xl text-ink mb-2">{пункт.заголовок}</p>
              <p class="text-lg text-muted">{пункт.текст}</p>
            </li>
          ))
        }
      </ul>

      <div class="border-l-4 border-accent pl-5">
        <p class="font-display text-2xl text-ink mb-2">
          {кого_ждём.прослушивание.заголовок}
        </p>
        <p class="text-lg md:text-xl text-muted">{кого_ждём.прослушивание.текст}</p>
      </div>
    </Section>

    <!-- Репетиции -->
    <Section id="rehearsals" title={репетиции.заголовок} tone={тон.rehearsals}>
      <dl class="mb-8">
        {
          репетиции.расписание.map((строка) => (
            <div class="flex justify-between gap-4 py-3 border-b border-line text-lg md:text-xl">
              <dt class="font-semibold text-ink">{строка.день}</dt>
              <dd class="text-muted">{строка.время}</dd>
            </div>
          ))
        }
      </dl>

      <p class="font-display text-2xl text-ink mb-2">{репетиции.адрес}</p>
      <p class="text-lg text-muted mb-6">{репетиции.как_добраться}</p>

      <a
        href={репетиции.ссылка_на_карту}
        target="_blank"
        rel="noopener"
        class="inline-block rounded-md border-2 border-accent px-6 py-3 text-lg font-semibold text-accent hover:bg-accent-soft"
      >
        Посмотреть на карте
      </a>

      <div class="mt-10">
        <h3 class="font-display text-2xl text-ink mb-4">
          {репетиции.стоимость.заголовок}
        </h3>

        <table class="w-full text-lg md:text-xl border-collapse">
          <tbody>
            {
              репетиции.стоимость.строки.map((строка) => (
                <tr class="border-b border-line">
                  <th scope="row" class="text-left font-normal text-muted py-3 pr-4 align-top">
                    {строка.что}
                  </th>
                  <td class="text-right font-semibold text-ink py-3 whitespace-nowrap align-top">
                    {строка.цена}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        {
          репетиции.стоимость.примечание && (
            <p class="text-lg text-muted mt-4">{репетиции.стоимость.примечание}</p>
          )
        }
      </div>
    </Section>

    <!-- Видео -->
    {
      видео.записи.length > 0 && (
        <Section id="video" title={видео.заголовок} tone={тон.video}>
          <p class="text-xl text-muted mb-8">{видео.вступление}</p>
          <ul class="grid sm:grid-cols-2 gap-6">
            {видео.записи.map((запись) => (
              <li>
                <a href={запись.ссылка} target="_blank" rel="noopener" class="block group">
                  <img
                    src={запись.обложка}
                    alt={запись.название}
                    width="800"
                    height="450"
                    class="w-full h-auto rounded-md mb-3"
                  />
                  <p class="font-display text-xl text-accent group-hover:underline">
                    {запись.название}
                  </p>
                  <p class="text-muted">{запись.где_когда}</p>
                </a>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <!-- Фотографии -->
    {
      галерея.снимки.length > 0 && (
        <Section id="gallery" title={галерея.заголовок} tone={тон.gallery}>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {галерея.снимки.map((снимок) => (
              <li>
                {/*
                  Обычная ссылка на файл, а не кнопка: если скрипт не сработает
                  или браузер окажется старым, снимок всё равно откроется —
                  просто отдельной страницей. Окно просмотра подключается
                  поверх этого, в скрипте внизу.
                */}
                <a
                  href={снимок.файл}
                  data-full={снимок.файл}
                  data-caption={снимок.подпись}
                  class="block cursor-zoom-in"
                >
                  <img
                    src={снимок.файл}
                    alt={снимок.подпись}
                    width="800"
                    height="600"
                    loading="lazy"
                    class="w-full h-auto rounded-md"
                  />
                </a>
                <p class="text-muted mt-2">{снимок.подпись}</p>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <!-- Анонсы -->
    {
      анонсы.события.length > 0 && (
        <Section id="events" title={анонсы.заголовок} tone={тон.events}>
          <ul>
            {анонсы.события.map((событие) => (
              <li class="bg-surface rounded-md p-6 border border-line mb-5 last:mb-0">
                <p class="text-accent font-semibold text-lg mb-1">
                  {событие.дата}, {событие.время}
                </p>
                <p class="font-display text-2xl text-ink mb-2">{событие.название}</p>
                <p class="text-lg text-muted mb-1">{событие.место}</p>
                <p class="text-lg text-muted">{событие.описание}</p>
                {событие.ссылка && (
                  <a
                    href={событие.ссылка}
                    target="_blank"
                    rel="noopener"
                    class="inline-block mt-3 text-lg font-semibold text-accent underline"
                  >
                    Подробнее
                  </a>
                )}
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <!-- Достижения -->
    {
      достижения.пункты.length > 0 && (
        <Section id="achievements" title={достижения.заголовок} tone={тон.achievements}>
          <ul>
            {достижения.пункты.map((пункт) => (
              <li class="flex gap-5 py-4 border-b border-line last:border-0">
                <span class="font-display text-2xl text-accent shrink-0 w-20">
                  {пункт.год}
                </span>
                <span class="text-lg md:text-xl text-muted">{пункт.текст}</span>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <!-- Контакты -->
    <Section id="contacts" title={контакты.заголовок} tone={тон.contacts}>
      <p class="text-xl text-muted mb-8">{контакты.вступление}</p>

      <div class="mb-8">
        <ApplyButton size="large" />
        {
          заявка.после_заявки && (
            <p class="text-lg text-muted mt-4 max-w-xl">{заявка.после_заявки}</p>
          )
        }
      </div>

      {/*
        Список способов связи показывается, только если хоть один заполнен.
        Сейчас все пустые — остаётся одна форма, и пустой список на странице
        ни к чему.
      */}
      <ul
        class="text-lg md:text-xl"
        hidden={!(контакты.телефон || контакты.телеграм || контакты.вконтакте || контакты.почта)}
      >
        {
          контакты.телефон && (
            <li class="py-3 border-b border-line">
              <a href={`tel:${контакты.телефон_для_ссылки}`} class="text-accent font-semibold">
                {контакты.телефон}
              </a>
            </li>
          )
        }
        {
          контакты.телеграм && (
            <li class="py-3 border-b border-line">
              <a href={контакты.телеграм} target="_blank" rel="noopener" class="text-accent font-semibold">
                Телеграм
              </a>
            </li>
          )
        }
        {
          контакты.вконтакте && (
            <li class="py-3 border-b border-line">
              <a href={контакты.вконтакте} target="_blank" rel="noopener" class="text-accent font-semibold">
                ВКонтакте
              </a>
            </li>
          )
        }
        {
          контакты.почта && (
            <li class="py-3 border-b border-line">
              <a href={`mailto:${контакты.почта}`} class="text-accent font-semibold">
                {контакты.почта}
              </a>
            </li>
          )
        }
      </ul>
    </Section>

    <!-- Вопросы -->
    <Section id="faq" title={вопросы.заголовок} tone={тон.faq}>
      <ul>
        {
          вопросы.список.map((пункт) => (
            <li class="py-5 border-b border-line last:border-0">
              <p class="font-display text-xl md:text-2xl text-ink mb-2">
                {пункт.вопрос}
              </p>
              <p class="text-lg md:text-xl text-muted">{пункт.ответ}</p>
            </li>
          ))
        }
      </ul>

      {/*
        Кнопка повторена в конце страницы: контакты теперь стоят выше вопросов,
        и без неё человек, дочитавший до последнего ответа, упирается в подвал
        без единого способа действовать.
      */}
      <div class="mt-10">
        <ApplyButton size="large" />
      </div>
    </Section>

    <footer class="bg-ink text-paper py-10">
      <div class="mx-auto w-full max-w-3xl px-5">
        <p class="text-lg">{контакты.подпись}</p>
      </div>
    </footer>

    <!-- Кнопка заявки, закреплённая внизу экрана телефона -->
    <div
      class="md:hidden fixed bottom-0 inset-x-0 bg-surface border-t border-line px-4 pt-3"
      style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));"
    >
      <ApplyButton class="w-full text-center" />
    </div>

    <!--
      Окно просмотра фотографии. Открывается только по нажатию на снимок —
      само не появляется. Кнопка закрытия подписана словом и сделана крупной:
      крестик в углу для нашей аудитории не очевиден. Закрыть можно ещё
      клавишей Esc и нажатием мимо снимка — это умеет сам элемент dialog.
    -->
    <!--
      fixed inset-0 m-auto h-fit — окно встаёт ровно посередине экрана
      и по горизонтали, и по вертикали. Браузеры по-разному располагают
      dialog по умолчанию, чаще прижимают кверху, поэтому положение задано явно.
    -->
    <dialog
      id="lightbox"
      class="fixed inset-0 m-auto h-fit w-[95vw] max-w-5xl bg-surface p-0 border border-line backdrop:bg-ink/85"
    >
      <div class="p-4">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="w-full h-auto max-h-[72vh] object-contain"
        />
        <p id="lightbox-caption" class="text-lg text-muted mt-3"></p>
        <button
          type="button"
          id="lightbox-close"
          class="mt-4 w-full sm:w-auto px-9 py-3.5 text-lg font-semibold bg-accent text-white hover:bg-accent-dark"
        >
          Закрыть
        </button>
      </div>
    </dialog>

    <script is:inline>
      ;(function () {
        var d = document.getElementById('lightbox')
        if (!d || typeof d.showModal !== 'function') return

        var img = document.getElementById('lightbox-img')
        var cap = document.getElementById('lightbox-caption')

        document.addEventListener('click', function (e) {
          var t = e.target
          if (!t || !t.closest) return

          var link = t.closest('a[data-full]')
          if (link) {
            e.preventDefault()
            img.src = link.getAttribute('data-full')
            img.alt = link.getAttribute('data-caption') || ''
            cap.textContent = link.getAttribute('data-caption') || ''
            d.showModal()
            return
          }

          if (t.id === 'lightbox-close') d.close()
        })

        // Нажатие мимо снимка — по затемнённому фону — тоже закрывает.
        d.addEventListener('click', function (e) {
          if (e.target === d) d.close()
        })
      })()
    </script>

    {
      сайт.счётчик_метрики && (
        <Fragment>
          <script is:inline set:html={метрика} />
          <noscript>
            <div>
              <img
                src={`https://mc.yandex.ru/watch/${сайт.счётчик_метрики}`}
                style="position:absolute; left:-9999px;"
                alt=""
              />
            </div>
          </noscript>
        </Fragment>
      )
    }
  
