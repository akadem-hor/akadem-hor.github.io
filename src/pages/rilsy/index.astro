---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Рилсы хора «Голоса»</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;800&family=Golos+Text:wght@400;500&display=swap" />
    <style is:global>
      /* Лента программки: шапка, затем сетка карточек-роликов по датам */
      :root {
        --bg: #f6f4f8; --surface: #ffffff; --ink: #221a2b; --muted: #6a6175; --line: #e3dde9;
        --plum: #6d2a63; --teal: #16766f; --chip: #efe7f2;
        --display: 'Montserrat', system-ui, sans-serif; --body: 'Golos Text', system-ui, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #15121a; --surface: #1f1a26; --ink: #efeaf3; --muted: #a59bb0; --line: #2f2838;
          --plum: #d58bc6; --teal: #5fc4b8; --chip: #2c2234; color-scheme: dark;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--body);
        padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
        padding-block: 32px 56px;
      }
      .wrap { max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 28px; }
      .nav { display: flex; gap: 8px; flex-wrap: wrap; font: 600 13px var(--display); text-transform: uppercase; letter-spacing: 0.06em; }
      .nav a, .nav span { padding: 6px 12px; border-radius: 999px; text-decoration: none; color: var(--muted); background: var(--chip); }
      .nav span { color: var(--surface); background: var(--plum); }
      .top h1 { font: 800 clamp(28px, 5vw, 44px)/1.1 var(--display); letter-spacing: 0.01em; text-transform: uppercase; margin: 0; text-wrap: balance; }
      .top p { margin: 8px 0 0; color: var(--muted); max-width: 62ch; }
      .rule { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--muted); font-size: 14px; }
      .rule b { color: var(--ink); font-weight: 500; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 20px; }
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
      .ch { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
      .date { font: 800 15px var(--display); color: var(--plum); text-transform: uppercase; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
      .chips { display: flex; gap: 6px; flex-wrap: wrap; }
      .chip { font: 600 11px var(--display); text-transform: uppercase; letter-spacing: 0.06em; background: var(--chip); color: var(--muted); padding: 3px 8px; border-radius: 999px; }
      .chip.pin { color: var(--teal); }
      h2 { font: 800 18px/1.25 var(--display); margin: 0; text-wrap: balance; }
      video { width: 100%; max-width: 100%; aspect-ratio: 9 / 16; background: #000; border-radius: 10px; display: block; }
      details summary { cursor: pointer; color: var(--teal); font-weight: 500; }
      .cap { white-space: pre-wrap; font: 14px/1.5 var(--body); margin: 8px 0; color: var(--ink); }
      .copy { font: 600 13px var(--display); border: 1px solid var(--line); background: transparent; color: var(--ink); border-radius: 8px; padding: 7px 12px; cursor: pointer; }
      .copy:focus-visible, summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <nav class="nav" aria-label="Материалы для соцсетей">
        <span aria-current="page">Рилсы</span>
        <a href="/vk/">Картинки ВК и истории</a>
      </nav>
      <section class="top">
        <h1>Рилсы хора</h1>
        <p>Академический любительский хор, Екатеринбург. Девять готовых роликов в порядке публикации, с датами и подписями.</p>
      </section>
      <div class="rule">
        <span><b>Ритм:</b> среда, пятница, воскресенье, вечером</span>
        <span><b>Воскресенье:</b> концертный ролик</span>
        <span><b>Ср 28.10:</b> подготовка к опере (в работе)</span>
      </div>
      <section class="grid">
        {рилсы.map((р, i) => (
          <article class="card" id={`r${i + 1}`}>
            <header class="ch">
              <span class="date">{р.дата}</span>
              <div class="chips">
                {р.метки.map((м) => <span class:list={['chip', м.закрепить && 'pin']}>{м.текст}</span>)}
              </div>
            </header>
            <h2>{р.название}</h2>
            <video controls playsinline preload="none" poster={`/rilsy/v/${р.файл}.jpg?v=${сборка}`} src={`/rilsy/v/${р.файл}.mp4?v=${сборка}`}></video>
            <details>
              <summary>Подпись к посту</summary>
              <pre class="cap" id={`c${i + 1}`}>{р.подпись}</pre>
              <button type="button" class="copy" data-t={`c${i + 1}`}>Скопировать подпись</button>
            </details>
          </article>
        ))}
      </section>
    </div>
    <script is:inline>
      document.querySelectorAll('.copy').forEach(function (b) {
        b.addEventListener('click', function () {
          var el = document.getElementById(b.dataset.t)
          var done = function (t) { b.textContent = t; setTimeout(function () { b.textContent = 'Скопировать подпись' }, 2500) }
          navigator.clipboard.writeText(el.textContent).then(function () { done('Скопировано') }, function () {
            var r = document.createRange(); r.selectNodeContents(el)
            var s = getSelection(); s.removeAllRanges(); s.addRange(r)
            done('Выделено, нажмите «Копировать»')
          })
        })
      })
    </script>
  </body>
</html>
