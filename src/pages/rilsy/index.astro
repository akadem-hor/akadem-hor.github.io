---
/**
 * План публикаций в соцсетях: девять готовых рилсов с датами и подписями.
 * Страница для руководителя хора — показать единый стиль роликов, подписи
 * и сами видео (14.10.2026). Перенесена со страницы Claude, к которой у
 * руководителя нет доступа. Закрыта от поисковиков, в карту сайта не входит,
 * ссылок на неё с сайта нет.
 *
 * Видео и обложки — public/rilsy/v/. Чтобы добавить ролик, положите туда
 * файлы и допишите блок в список ниже.
 */
interface Рилс {
  дата: string
  метки: { текст: string; закрепить?: boolean }[]
  название: string
  файл: string
  подпись: string
}

// метка сборки в адресе файлов: после замены ролика телефон не покажет старый из кэша
const сборка = Date.now().toString(36)

const рилсы: Рилс[] = [
  {
    дата: 'Ср 14.10',
    метки: [{ текст: 'Старт · 1 из 3' }, { текст: 'Закрепить', закрепить: true }],
    название: 'Верхотурье',
    файл: 'reels_verhoturye',
    подпись: `Май, поезд, Верхотурье 🚂
Ездили всем хором на областной конкурс хоров. Вышли на сцену и привезли диплом II степени. А на гала-концерте пели в Крестовоздвиженском соборе. Мурашки до сих пор.
Между выступлениями гуляли по городу, водили хороводы. Настоящий мини-отпуск.

Мы любительский академический хор из Екатеринбурга. Учим партии по нотам, выступаем на концертах и конкурсах, ездим в поездки.
Сейчас идёт набор 🎶 Первая репетиция бесплатно.
📍 Ленина, 97а · Пн и пт, 18:30
Анкета — по ссылке в профиле 👆
#хорекатеринбург #академическийхор #любительскийхор #верхотурье #хоровойконкурс`,
  },
  {
    дата: 'Ср 14.10',
    метки: [{ текст: 'Старт · 2 из 3' }, { текст: 'Закрепить', закрепить: true }],
    название: 'Что мы поём',
    файл: 'reels_repertuar_2025_26',
