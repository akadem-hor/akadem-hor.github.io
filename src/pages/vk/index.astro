---
/**
 * Картинки для оформления сообщества ВКонтакте и истории для Инстаграма —
 * показать руководителю и скачать с телефона (с 14.10.2026).
 *
 * Два набора одного состава:
 * — «Спокойный» (19.10.2026) — по макетам дизайнера: белый фон и серый
 *   градиент, «ХОР» и круг тёмно-синим. С него начинаем: в сообществе
 *   много хористок старшего поколения. Картинки — public/vk/calm/;
 * — «Яркий» — градиент главной страницы сайта. Картинки — public/vk/.
 * Название хора на картинках пока не пишем: «Академический любительский
 * хор в Екатеринбурге». Исходники PNG — папки «вк-спокойное-оформление»,
 * «вк-оформление» и «инстаграм-сториз» рядом с сайтом.
 *
 * Закрыта от поисковиков, в карту сайта не входит, ссылок с сайта нет.
 */
interface Картинка { файл: string; скачать: string; название: string; размер: string; куда: string; широкая?: boolean }

// метка сборки в адресах: после обновления телефон не покажет старую картинку из кэша
const сборка = Date.now().toString(36)

const ГДЕ = {
  обложка: '«Управление» → «Настройки» → «Обложка сообщества» → «Загрузить». На телефоне ВК обрезает края, поэтому всё важное стоит по центру.',
  аватар: 'Наведите на фото сообщества → «Обновить фотографию». Кружок выделите так, чтобы голова была по центру.',
  набор: 'Запись на стене с текстом про набор и ссылкой на анкету. После публикации: «…» → «Закрепить» — пост будет первым.',
  расписание: 'Обычная запись на стене. Можно повторять раз в месяц-два, чтобы новые люди видели время и цены.',
}
const основное = (папка: string, приставка: string): Картинка[] => [
  { файл: `${папка}cover.jpg`, скачать: `${приставка}обложка-1920x768.jpg`, название: 'Обложка сообщества', размер: '1920 × 768', куда: ГДЕ.обложка, широкая: true },
  { файл: `${папка}avatar.jpg`, скачать: `${приставка}аватар-1080x1080.jpg`, название: 'Аватар', размер: '1080 × 1080', куда: ГДЕ.аватар },
  { файл: `${папка}post-nabor.jpg`, скачать: `${приставка}пост-идёт-набор-1080x1350.jpg`, название: 'Пост «Идёт набор»', размер: '1080 × 1350', куда: ГДЕ.набор },
  { файл: `${папка}post-raspisanie.jpg`, скачать: `${приставка}пост-расписание-1080x1350.jpg`, название: 'Пост «Расписание и цены»', размер: '1080 × 1350', куда: ГДЕ.расписание },
]
const меню = (папка: string, приставка: string) =>
  ['О хоре', 'Записаться', 'Расписание', 'Концерты', 'Вопросы', 'Выступления'].map((н, i) => ({
    файл: `${папка}menu-${i + 1}.jpg`, скачать: `${приставка}меню-${i + 1}-${н.toLowerCase()}.jpg`, название: н,
  }))
const истории = (папка: string, приставка: string) => [
  { файл: `${папка}story.jpg`, скачать: `${приставка}история-идёт-набор-1080x1920.jpg`, название: 'Идёт набор' },
  { файл: `${папка}story-kogda.jpg`, скачать: `${приставка}история-когда-и-где-1080x1920.jpg`, название: 'Когда и где' },
  { файл: `${папка}story-ceny.jpg`, скачать: `${приставка}история-цены-1080x1920.jpg`, название: 'Цены' },
]

const наборы = [
  {
    id: 'calm', заголовок: 'Спокойное оформление', метка: 'Начинаем с него',
    описание: 'Белый фон и серый градиент, «ХОР» и круг тёмно-синим — по макетам дизайнера. Сдержанно и понятно для всех возрастов.',
    папка: 'calm/', приставка: 'спокойное-',
  },
  {
    id: 'bright', заголовок: 'Яркое оформление', метка: 'На потом',
    описание: 'Розово-фиолетово-бирюзовый градиент, как на главной странице сайта. Можно перейти на него позже.',
    папка: '', приставка: 'яркое-',
  },
]
const адрес = (файл: string) => `/vk/${файл}?v=${сборка}`
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Картинки для соцсетей — хор</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;800&family=Golos+Text:wght@400;500&display=swap" />
    <style is:global>
      /* Как страница рилсов: шапка, затем карточки с картинкой, подсказкой и кнопкой */
      :root {
        --bg: #f6f4f8; --surface: #ffffff; --ink: #221a2b; --muted: #6a6175; --line: #e3dde9;
        --plum: #6d2a63; --teal: #16766f; --chip: #efe7f2;
        --display: 'Montserrat', system-ui, sans-serif; --body: 'Golos Text', system-ui, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #15121a; --surface: #1f1a26; --ink: #efeaf3; --muted: #a59bb0; --line: #2f2838;
          --plum: #d58bc6; --teal: #5fc4b8; --chip: #2c2234; color-scheme: dark;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.55 var(--body);
        padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px));
        padding-block: 32px 56px;
      }
      img { display: block; max-width: 100%; height: auto; }
      .wrap { max-width: 1180px; margin: 0 auto; display: flex; flex-direction: column; gap: 28px; }
      .nav { display: flex; gap: 8px; flex-wrap: wrap; font: 600 13px var(--display); text-transform: uppercase; letter-spacing: 0.06em; }
      .nav a, .nav span { padding: 6px 12px; border-radius: 999px; text-decoration: none; color: var(--muted); background: var(--chip); }
      .nav span { color: var(--surface); background: var(--plum); }
      .top h1 { font: 800 clamp(28px, 5vw, 44px)/1.1 var(--display); letter-spacing: 0.01em; text-transform: uppercase; margin: 0; text-wrap: balance; }
      .top p { margin: 8px 0 0; color: var(--muted); max-width: 64ch; }
      .jump { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; }
      .jump a { color: var(--teal); }
      .set { display: flex; flex-direction: column; gap: 20px; padding-top: 12px; border-top: 2px solid var(--line); }
      .set__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 14px; }
      .set__head h2 { font: 800 clamp(22px, 4vw, 30px)/1.15 var(--display); text-transform: uppercase; margin: 0; }
      .set p { margin: 0; color: var(--muted); max-width: 64ch; }
      h3 { font: 800 18px/1.25 var(--display); margin: 0; text-wrap: balance; }
      .sub { font: 800 15px var(--display); text-transform: uppercase; letter-spacing: 0.06em; color: var(--plum); margin: 8px 0 0; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 20px; align-items: start; }
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
      .card--wide { grid-column: 1 / -1; }
      .card img { border-radius: 10px; width: 100%; }
      .ch { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
      .chip { font: 600 11px var(--display); text-transform: uppercase; letter-spacing: 0.06em; background: var(--chip); color: var(--muted); padding: 3px 8px; border-radius: 999px; font-variant-numeric: tabular-nums; }
      .chip--accent { color: var(--surface); background: var(--teal); }
      .where { margin: 0; font-size: 14px; color: var(--muted); }
      .dl {
        align-self: flex-start; font: 600 13px var(--display); text-decoration: none; color: var(--surface); background: var(--teal);
        border-radius: 8px; padding: 9px 14px;
      }
      .dl:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
      .menu { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); gap: 12px; }
      .menu figure { margin: 0; display: grid; gap: 8px; }
      .menu figcaption { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 14px; }
      .menu .dl { padding: 6px 10px; font-size: 12px; }
      .note { font-size: 14px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 16px; max-width: 70ch; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <nav class="nav" aria-label="Материалы для соцсетей">
        <a href="/rilsy/">Рилсы</a>
        <span aria-current="page">Картинки ВК и истории</span>
        <a href="/teksty/">Тексты ВК</a>
      </nav>
      <section class="top">
        <h1>Картинки для ВК и историй</h1>
        <p>Два варианта оформления одного состава: спокойный — с него начинаем — и яркий, как на сайте. Под каждой картинкой — куда её ставить и кнопка «Скачать». Сначала ставьте аватар, обложку и закреплённый пост «Идёт набор», потом кнопки меню.</p>
      </section>
      <div class="jump">
        {наборы.map((н) => <a href={`#${н.id}`}>{н.заголовок}</a>)}
      </div>

      {наборы.map((н) => (
        <section class="set" id={н.id}>
          <div class="set__head">
            <h2>{н.заголовок}</h2>
            <span class:list={['chip', н.id === 'calm' && 'chip--accent']}>{н.метка}</span>
          </div>
          <p>{н.описание}</p>

          <p class="sub">ВКонтакте</p>
          <div class="grid">
            {основное(н.папка, н.приставка).map((к, i) => (
              <article class:list={['card', к.широкая && 'card--wide']}>
                <header class="ch">
                  <h3>{к.название}</h3>
                  <span class="chip">{к.размер}</span>
                </header>
                <img src={адрес(к.файл)} alt={к.название} loading={н.id === 'calm' && i < 2 ? 'eager' : 'lazy'} />
                <p class="where">{к.куда}</p>
                <a class="dl" href={адрес(к.файл)} download={к.скачать}>Скачать</a>
              </article>
            ))}
            <article class="card card--wide">
              <header class="ch">
                <h3>Кнопки меню</h3>
                <span class="chip">376 × 256</span>
              </header>
              <div class="menu">
                {меню(н.папка, н.приставка).map((м) => (
                  <figure>
                    <img src={адрес(м.файл)} alt={`Кнопка «${м.название}»`} loading="lazy" />
                    <figcaption>
                      <span>{м.название}</span>
                      <a class="dl" href={адрес(м.файл)} download={м.скачать}>Скачать</a>
                    </figcaption>
                  </figure>
                ))}
              </div>
              <p class="where">
                «Управление» → «Меню» → «Новая ссылка»: название, ссылка и картинка. Добавляйте по порядку, с 1 по 5; «Выступления» — шестой, она продолжает цвет пятой.
                В меню ВК обычно принимает только ссылки внутри ВКонтакте: на статью, альбом, видео или пост. Ссылку на сайт
                и анкету поставьте в «Управление» → «Кнопка действия» и «Управление» → «Ссылки».
              </p>
            </article>
          </div>

          <p class="sub">Истории — Инстаграм и ВК</p>
          <p>Размер 1080 × 1920. В Инстаграме: «+» → «История» → выбрать картинку из галереи. В ВК — с телефона, кружок с плюсом. Важное стоит по центру: надписи и кнопки сверху и снизу его не закроют.</p>
          <div class="grid">
            {истории(н.папка, н.приставка).map((и) => (
              <article class="card">
                <header class="ch">
                  <h3>{и.название}</h3>
                  <span class="chip">1080 × 1920</span>
                </header>
                <img src={адрес(и.файл)} alt={`История «${и.название}»`} loading="lazy" />
                <a class="dl" href={адрес(и.файл)} download={и.скачать}>Скачать</a>
              </article>
            ))}
          </div>
        </section>
      ))}

      <p class="note">
        На iPhone картинка по кнопке «Скачать» может просто открыться — тогда нажмите на неё и удерживайте,
        затем «Сохранить в Фото».
      </p>
    </div>
  </body>
</html>
