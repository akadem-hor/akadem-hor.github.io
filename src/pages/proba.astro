---
/**
 * Пробная страница нового оформления — /proba.
 *
 * Собрана 10.10.2026 по референсам камерного хора AUTEM, который руководитель
 * когда-то создала: античная голова как знак, широкий гротеск с разрядкой,
 * градиент из маджента в бирюзу, тёмные блоки. Задача — «молодёжно и
 * современно» вместо нынешнего «дамского» вида.
 *
 * Страница самостоятельная: свой каркас, свой шрифт, свои стили. Основной
 * сайт она не трогает и ничего у него не берёт, кроме текстов из
 * content.json — так оценивается именно оформление, а не заглушки.
 *
 * Закрыта от поисковиков (noindex, исключена из карты сайта в
 * astro.config.mjs) и не считается Метрикой — иначе просмотры пробы
 * смешались бы со статистикой настоящих посетителей.
 *
 * Голова — фотография мраморной головы женщины, Рим, Метрополитен-музей,
 * снимок DP202853, лицензия CC0. Фон убран в браузере: мрамор чуть теплее
 * нейтрально-серого фона съёмки, по этому признаку они и разделены.
 */
import '@fontsource/montserrat/cyrillic-400.css'
import '@fontsource/montserrat/cyrillic-600.css'
import '@fontsource/montserrat/cyrillic-800.css'
import '@fontsource/montserrat/latin-400.css'
import '@fontsource/montserrat/latin-600.css'
import '@fontsource/montserrat/latin-800.css'
import content from '../content.json'

const { заявка, обложка, о_хоре, хормейстеры, кого_ждём, репетиции, галерея, вопросы, контакты } =
  content

const внешняя = !заявка.ссылка_на_форму.startsWith('#')
const цель = внешняя ? { target: '_blank', rel: 'noopener' } : {}
const номер = (i: number) => String(i + 1).padStart(2, '0')

// Заголовок вкладки собирается здесь: выражение внутри <title> рядом с
// кавычкой-ёлочкой Astro разбирает неверно, и «»» вываливался на страницу.
const заголовок_вкладки = `Проба оформления — хор «${обложка.название}»`
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{заголовок_вкладки}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <p class="proba-tag">Пробная версия оформления</p>

    <!-- Обложка: имя сверху, огромное «ХОР» внизу, голова перед ним -->
    <header class="hero">
      <div class="hero__top">
        <h1 class="brand">
          <span class="brand__name">{обложка.название}</span>
          <span class="brand__kind">{обложка.подзаголовок}</span>
        </h1>
        <p class="hero__lead">{обложка.главная_фраза}</p>
        <a class="btn btn--light" href={заявка.ссылка_на_форму} {...цель}>{заявка.текст_кнопки}</a>
      </div>

      <div class="stage" aria-hidden="true">
        <span class="stage__word">ХОР</span>
        <div class="bust">
          <img src="/proba/head.webp" alt="" width="748" height="1299" />
          {/* Очки нарисованы здесь же, поверх снимка: свои, не с референса */}
          <svg class="bust__glasses" viewBox="0 0 300 70">
            <path d="M6 14 H294" stroke="#26e3cf" stroke-width="7" stroke-linecap="round" />
            <path d="M14 10 H136 Q140 10 139 16 L134 48 Q131 64 114 64 H40 Q22 64 19 48 L12 18 Q11 10 14 10 Z" fill="#141418" stroke="#26e3cf" stroke-width="7" />
            <path d="M164 10 H286 Q289 10 288 18 L281 48 Q278 64 260 64 H186 Q169 64 166 48 L161 16 Q160 10 164 10 Z" fill="#141418" stroke="#26e3cf" stroke-width="7" />
            <path d="M136 22 Q150 14 164 22" fill="none" stroke="#26e3cf" stroke-width="7" />
          </svg>
        </div>
      </div>
    </header>

    <main>
      <!-- О хоре -->
      <section class="block">
        <div class="wrap">
          <p class="label">01 — {о_хоре.заголовок}</p>
          <h2 class="title">{о_хоре.заголовок}</h2>
          <div class="text">
            {о_хоре.абзацы.map((абзац) => <p>{абзац}</p>)}
          </div>
        </div>
        <img class="wide-photo" src={обложка.фото} alt={обложка.описание_фото} width="1600" height="900" loading="lazy" />
      </section>

      <!-- Хормейстеры -->
      {
        хормейстеры.люди.length > 0 && (
          <section class="block block--alt">
            <div class="wrap">
              <p class="label">02 — Хормейстеры</p>
              <h2 class="title">{хормейстеры.заголовок}</h2>
              <div class="people">
                {хормейстеры.люди.map((человек) => (
                  <figure class="person">
                    <img src={человек.фото} alt={человек.имя} width="400" height="500" loading="lazy" />
                    <figcaption>
                      <span class="person__name">{человек.имя}</span>
                      <span class="person__role">{человек.должность}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </section>
        )
      }

      <!-- Кого ждём -->
      <section class="block">
        <div class="wrap">
          <p class="label">03 — Набор</p>
          <h2 class="title">{кого_ждём.заголовок}</h2>
          <p class="text text--lead">{кого_ждём.вступление}</p>
          <ul class="cards">
            {
              кого_ждём.пункты.map((пункт, i) => (
                <li class="card">
                  <span class="card__num grad">{номер(i)}</span>
                  <p class="card__title">{пункт.заголовок}</p>
                  <p class="card__text">{пункт.текст}</p>
                </li>
              ))
            }
          </ul>
          <div class="audition">
            <p class="audition__q">{кого_ждём.прослушивание.заголовок}</p>
            <p class="audition__a">{кого_ждём.прослушивание.текст}</p>
          </div>
        </div>
      </section>

      <!-- Репетиции -->
      <section class="block block--alt" id="rehearsals">
        <div class="wrap">
          <p class="label">04 — Репетиции</p>
          <h2 class="title">{репетиции.заголовок}</h2>

          <div class="days">
            {
              репетиции.расписание.map((строка) => (
                <div class="day">
                  <span class="day__name">{строка.день}</span>
                  <span class="day__time">{строка.время}</span>
                </div>
              ))
            }
          </div>

          <h3 class="subtitle">{репетиции.стоимость.заголовок}</h3>
          <table class="prices">
            <tbody>
              {
                репетиции.стоимость.строки.map((строка) => (
                  <tr>
                    <th scope="row">{строка.что}</th>
                    <td>{строка.цена}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          {репетиции.стоимость.примечание && <p class="note">{репетиции.стоимость.примечание}</p>}

          <h3 class="subtitle">{репетиции.заголовок_адреса}</h3>
          <p class="address">{репетиции.адрес}</p>
          <p class="note">{репетиции.как_добраться}</p>
          <a class="btn btn--ghost" href={репетиции.ссылка_на_карту} target="_blank" rel="noopener">Посмотреть на карте</a>
        </div>
      </section>

      <!-- Фотографии -->
      {
        галерея.снимки.length > 0 && (
          <section class="block">
            <div class="wrap">
              <p class="label">05 — Фото</p>
              <h2 class="title">{галерея.заголовок}</h2>
              <ul class="gallery">
                {галерея.снимки.map((снимок) => (
                  <li>
                    <img src={снимок.файл} alt={снимок.подпись} width="800" height="600" loading="lazy" />
                    <p>{снимок.подпись}</p>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      <!-- Запись: градиент и имя хора фоном, как на афишах AUTEM -->
      <section class="cta">
        <div class="cta__pattern" aria-hidden="true">
          {Array.from({ length: 8 }, () => <span>{обложка.название} {обложка.название} {обложка.название}</span>)}
        </div>
        <div class="wrap cta__inner">
          <h2 class="title title--dark">{контакты.заголовок}</h2>
          <p class="cta__text">{контакты.вступление}</p>
          <a class="btn btn--dark" href={заявка.ссылка_на_форму} {...цель}>{заявка.текст_кнопки}</a>
          {заявка.после_заявки && <p class="cta__promise">{заявка.после_заявки}</p>}
        </div>
      </section>

      <!-- Вопросы -->
      <section class="block">
        <div class="wrap">
          <p class="label">06 — FAQ</p>
          <h2 class="title">{вопросы.заголовок}</h2>
          <dl class="faq">
            {
              вопросы.список.map((пункт) => (
                <div class="faq__item">
                  <dt>{пункт.вопрос}</dt>
                  <dd>{пункт.ответ}</dd>
                </div>
              ))
            }
          </dl>
          <a class="btn btn--light" href={заявка.ссылка_на_форму} {...цель}>{заявка.текст_кнопки}</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <p class="footer__name">{обложка.название}</p>
        <p class="footer__kind">{контакты.подпись}</p>
      </div>
    </footer>

    <div class="sticky">
      <a class="btn btn--light btn--block" href={заявка.ссылка_на_форму} {...цель}>{заявка.текст_кнопки}</a>
    </div>
  </body>
</html>

<style is:global>
  /*
    Палитра снята с афиш AUTEM: почти чёрный, белый и градиент из маджента
    в бирюзу. Градиент — только акцент: фон обложки, цифры, призыв к записи.
    Если залить им всё, глаз устаёт, и он перестаёт что-либо выделять.

    Текст на тёмном — не чистый белый, а чуть приглушённый: чистый белый на
    чёрном «звенит» и утомляет при чтении длинных абзацев. Контраст обоих
    цветов текста к фону — выше 7:1.
  */
  :root {
    --bg: #0c0c10;
    --bg-alt: #141419;
    --card: #1b1b22;
    --line: #2b2b35;
    --text: #f1f1f4;
    --muted: #b0b0bd;
    --pink: #ff2fd8;
    --violet: #8f6bff;
    --cyan: #19f0d4;
    --grad: linear-gradient(135deg, var(--pink) 0%, var(--violet) 45%, var(--cyan) 100%);
    --font: 'Montserrat', 'Segoe UI', sans-serif;
    font-size: 18px;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  img { max-width: 100%; display: block; }
  :focus-visible { outline: 3px solid var(--cyan); outline-offset: 3px; }

  .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 20px; }

  .proba-tag {
    position: absolute; top: 12px; right: 12px; z-index: 50; margin: 0;
    padding: 6px 12px; border-radius: 999px;
    background: rgba(12, 12, 16, 0.75); color: #fff;
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  }

  /* ---------- Кнопки: скруглённые «таблетки», без резких углов ---------- */
  .btn {
    display: inline-block; padding: 16px 34px; border-radius: 999px;
    font-weight: 600; font-size: 1rem; letter-spacing: 0.04em;
    text-decoration: none; text-align: center;
  }
  .btn--light { background: #fff; color: #111; }
  .btn--light:hover { background: #eae6ff; }
  .btn--dark { background: #111; color: #fff; }
  .btn--dark:hover { background: #2a2a33; }
  .btn--ghost { border: 2px solid var(--text); color: var(--text); padding: 14px 32px; }
  .btn--ghost:hover { background: rgba(255, 255, 255, 0.08); }
  .btn--block { display: block; width: 100%; }

  /* ---------- Обложка ---------- */
  .hero {
    position: relative; min-height: 100svh; overflow: hidden;
    display: flex; flex-direction: column;
    background: linear-gradient(170deg, var(--pink) 0%, var(--violet) 42%, var(--cyan) 100%);
    color: #fff; text-align: center;
  }
  .hero__top { position: relative; z-index: 3; padding: 72px 20px 0; }
  .brand { margin: 0 0 28px; font-weight: 400; }
  .brand__name {
    display: block; font-weight: 600; text-transform: uppercase;
    font-size: clamp(2.6rem, 9vw, 6rem); line-height: 1;
    letter-spacing: 0.32em; margin-right: -0.32em; /* разрядка не сдвигает слово вбок */
  }
  .brand__kind {
    display: block; margin-top: 18px; font-size: clamp(0.8rem, 2.2vw, 1rem);
    text-transform: uppercase; letter-spacing: 0.3em; font-weight: 600; opacity: 0.95;
  }
  .hero__lead {
    max-width: 620px; margin: 0 auto 28px; font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.5;
  }

  .stage { position: relative; flex: 1; min-height: 460px; margin-top: 8px; }
  .stage__word {
    position: absolute; left: 50%; bottom: 6%; transform: translateX(-50%);
    font-weight: 800; font-size: clamp(11rem, 42vw, 34rem); line-height: 0.8;
    letter-spacing: -0.02em; color: #3b3b42; white-space: nowrap; z-index: 1;
  }
  .bust {
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
    height: 112%; max-height: 900px; aspect-ratio: 748 / 1299; z-index: 2;
  }
  .bust img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  /* На узком экране голова фронтальная и широкая — без уменьшения она закрывает всё слово */
  @media (max-width: 699px) {
    .stage { min-height: 400px; }
    .bust { height: 82%; }
    .stage__word { bottom: 10%; font-size: 46vw; }
  }
  .bust__glasses {
    /* Глаза на снимке — на 25% и 59% ширины, 37% высоты; центры линз в
       рисунке очков отстоят друг от друга на половину его ширины. */
    position: absolute; width: 69.6%; left: 7.5%; top: 31.9%; filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
  }

  /* ---------- Блоки ---------- */
  .block { padding: 96px 0; }
  .block--alt { background: var(--bg-alt); }
  .label {
    margin: 0 0 14px; font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.28em; text-transform: uppercase; color: var(--muted);
  }
  .title {
    margin: 0 0 36px; font-weight: 800; text-transform: uppercase;
    font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.05; letter-spacing: 0.01em;
  }
  .title--dark { color: #111; }
  .grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .subtitle {
    margin: 56px 0 18px; font-weight: 800; text-transform: uppercase;
    font-size: 1.25rem; letter-spacing: 0.08em;
  }
  .text { max-width: 760px; font-size: 1.1rem; color: var(--muted); }
  .text p { margin: 0 0 18px; }
  .text--lead { color: var(--text); font-size: 1.25rem; margin-bottom: 36px; }
  .wide-photo { width: 100%; max-width: 1080px; margin: 56px auto 0; filter: grayscale(1) contrast(1.05); }

  /* Хормейстеры — чёрно-белые, как скульптура на обложке */
  .people { display: grid; gap: 36px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .person { margin: 0; }
  .person img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; filter: grayscale(1) contrast(1.05); border-radius: 18px; }
  .person figcaption { margin-top: 18px; }
  .person__name { display: block; font-weight: 800; font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .person__role { display: block; color: var(--muted); margin-top: 4px; }

  /* Кого ждём */
  .cards { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 18px; }
  @media (min-width: 700px) { .cards { grid-template-columns: 1fr 1fr; } }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 28px; }
  .card__num { display: block; font-weight: 800; font-size: 2.4rem; line-height: 1; margin-bottom: 18px; }
  .card__title { margin: 0 0 8px; font-weight: 800; font-size: 1.15rem; }
  .card__text { margin: 0; color: var(--muted); }
  .audition {
    border-radius: 22px; padding: 2px; background: var(--grad);
  }
  .audition > * { margin: 0; }
  .audition__q, .audition__a { background: var(--bg); }
  .audition__q { padding: 26px 28px 6px; border-radius: 20px 20px 0 0; font-weight: 800; font-size: 1.3rem; }
  .audition__a { padding: 0 28px 26px; border-radius: 0 0 20px 20px; color: var(--muted); font-size: 1.1rem; }

  /* Репетиции */
  .days { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .day { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 26px 28px; }
  .day__name { display: block; font-weight: 800; text-transform: uppercase; font-size: 1.6rem; letter-spacing: 0.04em; }
  .day__time { display: block; margin-top: 6px; font-size: 1.25rem; color: var(--muted); }
  .prices { width: 100%; max-width: 760px; border-collapse: collapse; font-size: 1.1rem; }
  .prices th, .prices td { padding: 16px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prices th { text-align: left; font-weight: 400; color: var(--muted); padding-right: 16px; }
  .prices td { text-align: right; font-weight: 800; white-space: nowrap; }
  .note { color: var(--muted); max-width: 760px; margin: 14px 0 24px; }
  .address { font-size: 1.25rem; margin: 0; }

  /* Фото */
  .gallery { list-style: none; padding: 0; margin: 0; display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 18px; filter: grayscale(1) contrast(1.05); }
  .gallery img:hover { filter: none; }
  .gallery p { margin: 10px 0 0; color: var(--muted); font-size: 0.95rem; }

  /* Призыв к записи */
  .cta { position: relative; overflow: hidden; background: var(--grad); padding: 110px 0; color: #111; }
  .cta__pattern {
    position: absolute; inset: -20px; display: flex; flex-direction: column; gap: 0;
    font-weight: 800; text-transform: uppercase; font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95; color: rgba(255, 255, 255, 0.16); white-space: nowrap; user-select: none;
  }
  .cta__pattern span:nth-child(even) { margin-left: -30%; }
  .cta__inner { position: relative; }
  .cta__text { font-size: 1.25rem; max-width: 620px; margin: 0 0 30px; font-weight: 600; }
  .cta__promise { max-width: 560px; margin: 22px 0 0; }

  /* Вопросы */
  .faq { margin: 0 0 44px; display: grid; gap: 0 48px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .faq__item { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .faq dt { font-weight: 800; font-size: 1.15rem; margin-bottom: 8px; }
  .faq dd { margin: 0; color: var(--muted); }

  .footer { padding: 56px 0 110px; border-top: 1px solid var(--line); }
  .footer__name { margin: 0; font-weight: 600; text-transform: uppercase; letter-spacing: 0.32em; font-size: 1.3rem; }
  .footer__kind { margin: 8px 0 0; color: var(--muted); }

  /* Кнопка записи, закреплённая внизу экрана телефона */
  .sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px 16px;
    padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgba(12, 12, 16, 0.85); backdrop-filter: blur(8px);
  }
  @media (min-width: 768px) {
    .sticky { display: none; }
    .footer { padding-bottom: 56px; }
    .block { padding: 120px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
